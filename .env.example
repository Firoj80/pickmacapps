# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string (uses embedded PGLite fallback when unset)
DATABASE_URL=""

# ADMIN_PASSWORD: Password for PickMacApps /admin dashboard (defaults to preview mode when unset)
ADMIN_PASSWORD=""

# Dodo Payments integration (optional)
DODO_PAYMENTS_API_KEY=""
DODO_PRODUCT_ID=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# IndexNow & Cron secrets (optional)
INDEXNOW_KEY=""
INDEXNOW_ENABLE="0"
CRON_SECRET=""
